<% layout('../../layouts/app.layout') %>


    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Kontak</h4>
                    <p class="card-title-desc">
                        This is a list of devices connected to your WhatsApp account. You can manage and remove devices
                        as needed.
                    </p>
                    <div class="row mb-3">
                        <div class="col-sm-12">
                           <!-- //import kontak by excel  -->
                            <button type="button" class="btn btn-primary mb-2" data-bs-toggle="modal"
                                data-bs-target="#addPhonebookModal">
                                <i class="mdi mdi-plus me-1"></i> Tambah Kontak
                            </button>
                            <button type="button" class="btn btn-warning mb-2" data-bs-toggle="modal"
                                data-bs-target="#importModal">
                                <i class="mdi mdi-import me-1"></i> Import Kontak
                            </button>
                            <button type="button" class="btn btn-success mb-2" onclick="resetPhonebook('<%= uuid %>')">
                                <i class="mdi mdi-plus me-1"></i> Reset Kontak
                        </div>
                    <hr>

                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Hp</th>
                                    <th>Nama</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (phonebooks.length > 0) { %>
                                    <% phonebooks.forEach(contact => { %>
                                        <% phonebooks %>
                                        <tr>
                                            <td><%= contact.phone %></td>
                                            <td><%= contact.name %></td>
                                            <td>
                                                <a type="button" 
                                                    onclick="deletePhonebook('<%= contact.id %>')"
                                                class="btn btn-danger btn-sm">Hapus</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-center">Tidak ada kontak yang ditemukan.</td>
                                    </tr>
                                <% } %>
                               
                            </tbody>
                        </table>
                     
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Modal tambah phonebook -->
<div class="modal fade" id="addPhonebookModal" tabindex="-1" aria-labelledby="addPhonebookModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPhonebookModalLabel">Tambah Kontak</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="addPhonebookForm add-phonebook"  id="addPhonebookForm" method="POST">
                    <div class="mb-3">
                        <label for="phoneInput" class="form-label">Nomor HP</label>
                        <input type="text" class="form-control" id="phoneInput" name="phone" required>
                    </div>
                    <div class="mb-3">
                        <label for="nameInput" class="form-label">Nama Kontak</label>
                        <input type="text" class="form-control" id="nameInput" name="name" required>
                    </div>
                    <input type="hidden" name="uuid" value="<%= uuid %>">
                    <button type="submit" class="btn btn-primary">Tambah</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Kontak</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="importForm" enctype="multipart/form-data" action="/import-phonebook" method="POST">
                    <div class="mb-3">
                        <label for="fileInput" class="form-label">Pilih File Excel</label>
                        <input type="file" class="form-control" id="fileInput" name="excelFile" accept=".xlsx, .xls">
                    </div>
                    <input type="hidden" name="uuid" value="<%= uuid %>">
                    <button type="submit" class="btn btn-primary">Import</button>
                    <a href="/template-phonebook.xlsx" class="btn btn-secondary">Download Template</a>
                </form>
            </div>
        </div>
    </div>
</div>
   
    <script>

        // document ready ajax add phonebook
         $(document).ready(function() {
            $('#addPhonebookForm').on('submit', function(event) {
                event.preventDefault(); // Prevent the default form submission

                // Get form data
                var formData = $(this).serialize();

                // Send AJAX request to add phonebook entry
                fetch('/add-phonebook', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status) {
                        Swal.fire(
                            'Berhasil!',
                            'Kontak berhasil ditambahkan.',
                            'success'
                        ).then(() => {
                            // Optionally, you can redirect or refresh the page
                            location.reload(); // Reload the page to see the changes
                        });
                    } else {
                        Swal.fire(
                            'Gagal!',
                            'Gagal menambahkan kontak: ' + data.message,
                            'error'
                        );
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire(
                        'Error!',
                        'Terjadi kesalahan saat menambahkan kontak.',
                        'error'
                    );
                });
            });
        });

        // Function to delete a phonebook entry
        function deletePhonebook(id) {
            //confirm using sweetalert
            // Using a simple confirm dialog for deletion
            Swal.fire({
                title: 'Konfirmasi',
                text: "Apakah Anda yakin ingin menghapus kontak ini?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Ya, hapus!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Proceed with deletion
                    fetch(`/delete-phonebook/${id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status) {
                            Swal.fire(
                                'Deleted!',
                                'Kontak berhasil dihapus.',
                                'success'
                            ).then(() => {
                                // Optionally, you can redirect or refresh the page
                                location.reload(); // Reload the page to see the changes
                            });
                        } else {
                            Swal.fire(
                                'Gagal!',
                                'Gagal menghapus kontak: ' + data.message,
                                'error'
                            );
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire(
                            'Error!',
                            'Terjadi kesalahan saat menghapus kontak.',
                            'error'
                        );
                    });
                }
            });
        }

        // Function to reset phonebook
        function resetPhonebook(uuid) {
            Swal.fire({
                title: 'Konfirmasi',
                text: "Apakah Anda yakin ingin mereset kontak?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Ya, reset!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Proceed with reset
                    fetch(`/reset-phonebook/${uuid}`, {
                        method: 'DELETE',   
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status) {
                            Swal.fire(
                                'Berhasil!',
                                'Kontak berhasil direset.',
                                'success'
                            ).then(() => {
                                // Optionally, you can redirect or refresh the page
                                location.reload(); // Reload the page to see the changes
                            });
                        } else {
                            Swal.fire(
                                'Gagal!',
                                'Gagal mereset kontak: ' + data.message,
                                'error'
                            );
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire(
                            'Error!',
                            'Terjadi kesalahan saat mereset kontak.',
                            'error'
                        );
                    });
                }
            });

        }
      
    </script>