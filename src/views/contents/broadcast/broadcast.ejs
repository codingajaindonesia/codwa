<% layout('../../layouts/app.layout') %>


    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">List Broadcast</h4>
                    <p class="card-title-desc">
                        This is a list of broadcast messages that you have sent. You can view the status of each message
                        and
                        take actions as needed.
                    </p>
                    <hr>

                    <div >
                        <table id="datatable"  class="table table-bordered dt-responsive  nowrap w-100">
                            <thead>
                                <tr>
                                    <th>Phone</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Tanggal</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% broadcasts.forEach(broadcast => { %>
                                    <tr>
                                        <td><%= broadcast.phone %></td>
                                        <td><%= broadcast.name %></td>
                                        <td>
                                            <span class="badge bg-<%= broadcast.status === 'success' ? 'success' : 'danger' %>">
                                                <%= broadcast.status %>
                                            </span>
                                        </td>
                                        <td><%= new Date(broadcast.send_at).toLocaleString() %></td>
                                        <td>
                                            <button class="btn btn-danger btn-sm" id="btnDeleteBroadcast<%= broadcast.id %>"
                                                onclick="deleteBroadcast(<%= broadcast.id %>)">
                                                <i class="mdi mdi-delete"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                                

                            </tbody>
                        </table>
                        <div class="mt-3">
                            <!-- show button kirim broadcast when status is pending -->
                             <% if (status === 'pending') { %>
       <button class="btn btn-success" id="sendBroadcast" data-bs-toggle="modal"
                                data-bs-target="#modalCreateBroadcast">
                                <i class="mdi mdi-send"></i> Kirim Broadcast
                            </button>
<% } else if (status === 'waiting') { %>
        <button class="btn btn-warning" id="stopBroadcast" onclick="stopBroadcast()">
                                <i class="mdi mdi-stop"></i> Stop Broadcast
                            </button>
<% } else { %>
    <button class="btn btn-secondary">Tidak Diketahui</button>
<% } %>
                        
                       

                            <button class="btn btn-primary" data-bs-toggle="modal"
                                data-bs-target="#modalImportPhoneBook">
                                <i class="mdi mdi-import"></i> Import
                            </button>
                            <button class="btn btn-secondary" data-bs-toggle="modal"
                                data-bs-target="#modalAddContact">
                                <i class="mdi mdi-plus"></i> Add Kontak
                            </button>
                            <!-- reset kontak  -->
                             <button onclick="resetKontak()" class="btn btn-danger">
                                <i class="mdi mdi-refresh"></i> Reset Kontak
                            </button>
                        </div>



                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAddContact" tabindex="-1" aria-labelledby="modalAddContactLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAddContactLabel">Tambah Kontak</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formAddContact">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="phone" class="form-label">Hp</label>
                            <input type="hidden" name="uuid" value="<%= uuid %>">
                            <input type="text" class="form-control" id="phone" name="phone" required>
                        </div>
                        <div class="mb-3">
                            <label for="name" class="form-label">Nama</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                      
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<div class="modal fade" id="modalImportPhoneBook" tabindex="-1" aria-labelledby="modalImportPhoneBookLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalImportPhoneBookLabel">Import Phone Book</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formImportPhoneBook" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="filePhoneBook" class="form-label">Pilih Phonebook</label>
                      <select class="form-select" id="filePhoneBook" name="filePhoneBook" required>
                            <option value="">-- Pilih File --</option>
                            <% phonebooks.forEach(phoneBook => { %>
                                <option value="<%= phoneBook.id %>"><%= phoneBook.title %></option>
                            <% }) %>
                        </select>   
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

            <script>
                // Fungsi untuk add kontak
                $("#formAddContact").submit(function (event) {
                    event.preventDefault();

                    var formData = new FormData(this);

                    fetch('/broadcast/add-contact', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.status) {
                                Swal.fire(
                                    'Success!',
                                    data.message || 'Contact added successfully.',
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    data.message || 'Failed to add contact.',
                                    'error'
                                );
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Error!', 'An error occurred while adding the contact.', 'error');
                        });
                });

                // Function to import phone book
                $("#formImportPhoneBook").submit(function (event) {
                    event.preventDefault();

                    var formData = new FormData(this);

                    fetch('/broadcast/import-phonebook', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.status) {
                                Swal.fire(
                                    'Success!',
                                    data.message || 'Phone book imported successfully.',
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    data.message || 'Failed to import phone book.',
                                    'error'
                                );
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Error!', 'An error occurred while importing the phone book.', 'error');
                        });
                });


                // Function to reset contacts
                function resetKontak(uuid) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This will reset all contacts!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, reset it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('/broadcast/reset/'+uuid, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        Swal.fire(
                                            'Reset!',
                                            'All contacts have been reset.',
                                            'success'
                                        ).then(() => {
                                            location.reload(); // Reload the page to reflect changes
                                        });
                                    } else {
                                        Swal.fire(
                                            'Error!',
                                            data.message || 'Failed to reset contacts.',
                                            'error'
                                        );
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    Swal.fire(
                                        'Error!',
                                        'An error occurred while resetting contacts.',
                                        'error'
                                    );
                                });
                        }
                    });
                }


                //jalankan datatable
                $(document).ready(function () {
                    $('#datatable').DataTable({
                        "order": [[0, "desc"]], // Order by date descending
                        "columnDefs": [
                            { "orderable": false, "targets": 4 } // Disable sorting on the last column
                        ]
                    });
                });

                $("#formCreateBroadcast").submit(function (event) {
                    event.preventDefault();

                    var formData = new FormData(this);

                    // Optional: file size validation (client-side)
                    const fileInput = this.querySelector("input[name='attachment']");
                    if (fileInput && fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        const maxSize = 10 * 1024 * 1024;
                        if (file.size > maxSize) {
                            Swal.fire('Error!', 'File size exceeds 10 MB.', 'error');
                            return;
                        }
                    }

                    fetch('/broadcast', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.status) {
                                Swal.fire(
                                    'Success!',
                                    data.message || 'Broadcast created successfully.',
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    data.message || 'Failed to create broadcast.',
                                    'error'
                                );
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            Swal.fire('Error!', 'An error occurred while creating the broadcast.', 'error');
                        });
                });



                function deleteBroadcast(id) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Disable the button to prevent multiple clicks
                            document.getElementById(`btnDeleteBroadcast${id}`).disabled = true;

                            // Send DELETE request to the server
                            fetch(`/broadcasts/${id}`, {
                                method: 'DELETE',
                                headers: {
                                    'Content-Type': 'application/json',
                                }
                            })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        Swal.fire(
                                            'Deleted!',
                                            'Your broadcast has been deleted.',
                                            'success'
                                        ).then(() => {
                                            location.reload(); // Reload the page to reflect changes
                                        });
                                    } else {
                                        Swal.fire(
                                            'Error!',
                                            'Failed to delete broadcast.',
                                            'error'
                                        );
                                        document.getElementById(`btnDeleteBroadcast${id}`).disabled = false; // Re-enable button
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    Swal.fire(
                                        'Error!',
                                        'An error occurred while deleting the broadcast.',
                                        'error'
                                    );
                                    document.getElementById(`btnDeleteBroadcast${id}`).disabled = false; // Re-enable button
                                });
                        }
                    });

                }

            </script>