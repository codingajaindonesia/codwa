<% layout('../../layouts/app.layout') %>


    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">List Broadcast</h4>
                    <p class="card-title-desc">
                        This is a list of broadcast messages that you have sent. You can view the status of each message and
                        take actions as needed.
                    </p>
                    <hr>

                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Tanggal</th>

                                    <th>Type</th>
                                    <th>Judul</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% broadcasts.forEach(broadcast => { %>
                                    <tr>
                                        <td>
                                            <!-- format date to d F y H:i -->
                                            <%= new Date(broadcast.created_at).toLocaleDateString('id-ID', {
                                                day: '2-digit',
                                                month: 'long',
                                                year: 'numeric',
                                                hour: '2-digit',
                                                minute: '2-digit'

                                            }) %>


                                        <td>
                                            <%= broadcast.attachment_type %>
                                        </td>
                                        <td>
                                            <%= broadcast.title %>
                                        </td>
                                        <td>
                                            <!-- Display status total, pending, sent, failed jumlah pesannya badgenya gede lagi -->

                                            <span class="btn btn-primary btn-sm" style="size: 15px;">
                                                Total: <%= broadcast.is_total %>
                                            </span>
                                            <span class="btn btn-secondary btn-sm">
                                                Pending: <%= broadcast.is_pending %>
                                            </span>
                                            <span class="btn btn-success btn-sm">
                                                Sent: <%= broadcast.is_sent %>
                                            </span>
                                            <span class="btn btn-danger btn-sm">
                                                Failed: <%= broadcast.is_failed %>
                                            </span>


                                        </td>
                                        <td>
                                            <a class="btn btn-primary btn-sm" href="/broadcasts/<%= broadcast.id %>">Detail</a>
                                            <button aria-modal="true" data-bs-toggle="modal" data-bs-target="#modalBroadcast<%= broadcast.id %>" class="btn btn-warning btn-sm">Edit</button>
                                            <button id="btnDeleteBroadcast<%= broadcast.id %>" class="btn btn-danger btn-sm" onclick="deleteBroadcast('<%= broadcast.id %>')">Delete</button>
                                        </td>
                                    </tr>
                                <% }); %>
                               
                            </tbody>
                        </table>
                        <div class="mt-3">
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalBroadcastCreate">
                                <i class="mdi mdi-plus"></i> Create New Broadcast
                            </button>
                        </div>

                     
                    </div>

                </div>
            </div>
        </div>
    </div>
<!-- Modal Create Broadcast -->
<div class="modal fade" id="modalBroadcastCreate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Broadcast</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCreateBroadcast" ethod="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input id="uuid" name="uuid" type="text" class="form-control" hidden value="<%= uuid %>" >
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" name="title" placeholder="Masukkan judul broadcast ..." required>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control" id="message" name="message" rows="3" placeholder="Masukkan text pesan dari broadcast" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="attachment" class="form-label">Attachment</label>
                        <input type="file" class="form-control" id="attachment" name="attachment">
                        <small class="form-text text-muted">Kosongkan jika tidak isi berkas yang dikirim, berkas bisa dikirim png, jpg, mp4, doc, xls, pdf. khusus video hanya maksimal 10mb</small>
                    </div>

            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Create Broadcast</button>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
                </form>

        </div>
    </div>
</div>

<!-- Modal Edit Broadcast -->
<% broadcasts.forEach(broadcast => { %>
<div class="modal fade" id="modalBroadcast<%= broadcast.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Broadcast</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditBroadcast<%= broadcast.id %>" action="/broadcasts/<%= broadcast.id %>/edit" method="POST">
                    <input type="hidden" name="_method" value="PUT">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="title" name="title" value="<%= broadcast.title %>" required>
                    </div>
                 
                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control" id="message" name="message" rows="3" required><%= broadcast.message %></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="attachment" class="form-label">Attachment</label>
                        <input type="file" class="form-control" id="attachment" name="attachment">
                        <small class="form-text text-muted">Kosongkan jika tidak isi berkas yang dikirim, berkas bisa dikirim png, jpg, mp4, doc, xls, pdf. khusus video hanya maksimal 10mb</small>
                    </div>
                
            </div>
            <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Update Broadcast</button>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
                </form>

        </div>
    </div>
</div>
<% }); %>
   
    <script>
       $("#formCreateBroadcast").submit(function(event) {
    event.preventDefault();

    var formData = new FormData(this);

    // Optional: file size validation (client-side)
    const fileInput = this.querySelector("input[name='attachment']");
    if (fileInput && fileInput.files.length > 0) {
        const file = fileInput.files[0];
        const maxSize = 10 * 1024 * 1024;
        if (file.size > maxSize) {
            Swal.fire('Error!', 'File size exceeds 10 MB.', 'error');
            return;
        }
    }

    fetch('/broadcast', {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.status) {
            Swal.fire(
                'Success!',
                data.message || 'Broadcast created successfully.',
                'success'
            ).then(() => {
                location.reload();
            });
        } else {
            Swal.fire(
                'Error!',
                data.message || 'Failed to create broadcast.',
                'error'
            );
        }
    })
    .catch(error => {
        console.error('Error:', error);
        Swal.fire('Error!', 'An error occurred while creating the broadcast.', 'error');
    });
});



        function deleteBroadcast(id) {
Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                // Disable the button to prevent multiple clicks
                document.getElementById(`btnDeleteBroadcast${id}`).disabled = true;

                // Send DELETE request to the server
                fetch(`/broadcasts/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire(
                            'Deleted!',
                            'Your broadcast has been deleted.',
                            'success'
                        ).then(() => {
                            location.reload(); // Reload the page to reflect changes
                        });
                    } else {
                        Swal.fire(
                            'Error!',
                            'Failed to delete broadcast.',
                            'error'
                        );
                        document.getElementById(`btnDeleteBroadcast${id}`).disabled = false; // Re-enable button
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire(
                        'Error!',
                        'An error occurred while deleting the broadcast.',
                        'error'
                    );
                    document.getElementById(`btnDeleteBroadcast${id}`).disabled = false; // Re-enable button
                });
            }
        });

        }
      
    </script>